# Lists workflow instances that hold a non-stale cached validation result, together with the stored
# footprint hash (if any). Used by the ETL pipeline to decide which caches to re-check after a
# re-materialization. Already-stale instances are skipped (they will be recomputed on next access).
# Instances cached before the hashing feature have no ?hash; the pipeline treats those as changed.
SELECT ?workflow_instance ?hash
WHERE {
    GRAPH <https://crc1625.mdi.ruhr-uni-bochum.de/graph/workflows> {
        ?workflow_instance crc:lastValidatedAt ?last_validated_at .
        OPTIONAL { ?workflow_instance crc:validationCacheHash ?hash. }
        OPTIONAL { ?workflow_instance crc:validationCacheStale ?stale. }
        FILTER (!bound(?stale) || ?stale = false)
    }
}
