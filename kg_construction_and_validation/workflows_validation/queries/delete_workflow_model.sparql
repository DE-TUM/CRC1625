DELETE {
    GRAPH <https://crc1625.mdi.ruhr-uni-bochum.de/graph/workflows> {
        ?s ?p ?o.
    }
}
WHERE {
  GRAPH <https://crc1625.mdi.ruhr-uni-bochum.de/graph/workflows> {
    # Immediate neighborhood (outgoing)
    {
      <{workflow_model_iri}> ?p ?o.
      BIND(<{workflow_model_iri}> AS ?s).
    }

    # Handover workflow steps immediate neighborhood (outgoing)
    UNION
    {
      <{workflow_model_iri}> crc:substep/crc:nextStep* ?s.
      ?s ?p ?o.
    }

    # Handover workflow step templates
    UNION
    {
      <{workflow_model_iri}> crc:substep/crc:nextStep*/crc:hasTemplate ?s.
      ?s ?p ?o.
    }
  }
}
