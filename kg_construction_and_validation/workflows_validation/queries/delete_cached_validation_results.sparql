# Removes all cached individual validation results of a workflow instance: both the
# crc:hasCachedValidationResult links from its step assignments and the result nodes' own triples
# (two hops down). Run before persisting a freshly computed trace, so re-validation overwrites rather
# than accumulates.
DELETE {
    GRAPH <https://crc1625.mdi.ruhr-uni-bochum.de/graph/workflows> {
        ?assignment crc:hasCachedValidationResult ?result .
        ?result ?p ?o .
    }
}
WHERE {
    GRAPH <https://crc1625.mdi.ruhr-uni-bochum.de/graph/workflows> {
        <{workflow_instance_iri}> crc:hasAssignment ?assignment .
        ?assignment crc:hasCachedValidationResult ?result .
        ?result ?p ?o .
    }
}
