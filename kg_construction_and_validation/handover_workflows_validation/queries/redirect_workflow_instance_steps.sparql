DELETE {
    GRAPH <https://crc1625.mdi.ruhr-uni-bochum.de/graph/workflows> {
        ?workflow_instance_step_assignment crc:relatesToHandoverWorkflowStep <{old_workflow_model_step_iri}>.
    }
}
INSERT {
    GRAPH <https://crc1625.mdi.ruhr-uni-bochum.de/graph/workflows> {
        ?workflow_instance_step_assignment crc:relatesToHandoverWorkflowStep <{new_workflow_model_step_iri}>.
    }
}
WHERE {
  GRAPH <https://crc1625.mdi.ruhr-uni-bochum.de/graph/workflows> {
        ?workflow_instance_step_assignment crc:relatesToHandoverWorkflowStep <{old_workflow_model_step_iri}>.
  }
}
