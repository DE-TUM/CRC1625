<?xml version="1.0"?>
<rdf:RDF xmlns="https://crc1625.mdi.ruhr-uni-bochum.de#"
     xml:base="https://crc1625.mdi.ruhr-uni-bochum.de"
     xmlns:co="https://w3id.org/pmd/co/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:voaf="http://purl.org/vocommons/voaf#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="http://schema.org/"
     xmlns:crc1625="https://crc1625.mdi.ruhr-uni-bochum.de/">
    <owl:Ontology rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de">
        <owl:imports rdf:resource="https://purl.bioontology.org/ontology/OCE"/>
        <owl:imports rdf:resource="https://w3id.org/pmd/co/2.0.8"/>
        <dc:creator rdf:resource="https://orcid.org/0009-0006-0232-8677"/>
        <terms:abstract>Ontology for supporting the analysis of Compositionally Complex Solid Solutions (CCSS) in the context of the Collaborative Research Center (CRC) 1625.</terms:abstract>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-03-19</terms:date>
        <terms:description>Ontology for supporting the analysis of Compositionally Complex Solid Solutions (CCSS) in the context of the Collaborative Research Center (CRC) 1625.
                                          This ontology models the experimental (meta-)data, provenance and handover workflows present in MatInf instances and vocabulary employed for the analysis of CCSS, while additionally being compatible with existing Materials Science ontologies.
                                          This additionally includes the modelling of handover workflow models, and other (meta-)data that is exclusively used by the MatInf semantic layer.
                                          Note that some classes are not present in the ontology document. Namely, specific measurement types are dynamically generated, as they change between MatInf instances. Processes and activities for them, however, are included here.</terms:description>
        <terms:license rdf:resource="http://creativecommons.org/licenses/by-sa/4.0/"/>
        <terms:title xml:lang="en">CCSS Ontology</terms:title>
        <terms:title xml:lang="en">CCSS Ontology</terms:title>
        <voaf:extends rdf:resource="https://w3id.org/pmd/co/2.0.8"/>
        <schema:codeRepository rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/DE-TUM/CRC1625</schema:codeRepository>
        <owl:versionInfo>1.0.2</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/abstract -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/abstract"/>
    


    <!-- http://purl.org/dc/terms/date -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/date"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/vocommons/voaf#extends -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocommons/voaf#extends"/>
    


    <!-- http://schema.org/codeRepository -->


    <owl:AnnotationProperty rdf:about="http://schema.org/codeRepository"/>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/objectDescription -->


    <owl:AnnotationProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/objectDescription">
        <rdfs:comment>The annotation property object description points to the description of the RDMS object it refers to.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </owl:AnnotationProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/objectName -->


    <owl:AnnotationProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/objectName">
        <rdfs:comment>The datatype property object description points to the name of the RDMS object it refers to.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/ns/prov#wasAssociatedWith -->


    <rdf:Description rdf:about="http://www.w3.org/ns/prov#wasAssociatedWith">
        <owl:equivalentProperty rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/assignedTo"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/prov#wasAttributedTo -->


    <rdf:Description rdf:about="http://www.w3.org/ns/prov#wasAttributedTo">
        <owl:equivalentProperty rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/creator"/>
    </rdf:Description>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/assignedEntity -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/allowedProject">
        <rdfs:domain rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/HandoverWorkflowModelStep"/>
        <rdfs:range rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/Project"/>
        <rdfs:comment>Indicates that the handover group that the Handover workflow model step is checking is allowed to take place in the given group</rdfs:comment>
        <rdfs:label>Allowed project</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/assignedObject -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/assignedObject">
        <rdfs:subPropertyOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/assignedTo"/>
        <rdfs:domain rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/HandoverWorkflowInstanceAssignment"/>
        <rdfs:range rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/MaterialsLibrary"/>
        <rdfs:comment>Indicates that the Handover workflow assignment is related to the target materials library or sample</rdfs:comment>
        <rdfs:label>Assigned object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/assignedWorkflowModelStep -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/assignedWorkflowModelStep">
        <rdfs:subPropertyOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/assignedTo"/>
        <rdfs:domain rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/WorkflowModelStepAssignment"/>
        <rdfs:range rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/WorkflowModelStep"/>
        <rdfs:comment>Indicates that the given WorkflowModelStepAssignment is specifying the target WorkflowModelStep</rdfs:comment>
        <rdfs:label>Assigned workflow model step</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/characteristic -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/characteristic">
        <owl:equivalentProperty rdf:resource="https://w3id.org/pmd/co/characteristic"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment>The object property characteristic indicates a relationship between a Materials Library, Sample or Measurement Area and anything that further describes it in the RDMS.

This can be the result of applying an actual characterization technique on a sample (e.g., the results of TEM, EDX...), or associating it with miscellaneous file uploads (photos, documents...). A Measurement Area can also contain characteristics, such as individual EDX composition results.

The entity pointed by at by this property may contain metadata such as creators and dates, whose raw values (e.g. file paths or composition values) can be accessed by the crc:value property</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/composedOf -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/composedOf">
        <owl:equivalentProperty rdf:resource="https://w3id.org/pmd/co/composedOf"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment>The composed of object property is used to indicate that a Materials Library or Sample is composed of other objects. These can be sample (pieces), treated samples (e.g. annealed samples) or any other kind of derivation that is registered in the RDMS as a separate object for better traceability.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/creator -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/creator">
        <rdfs:comment>The creator of the object, characterization, etc. it refers to, as indicated in the RDMS.</rdfs:comment>
        <rdfs:label>Creator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/element -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/element">
        <owl:equivalentProperty rdf:resource="https://w3id.org/pmd/co/relatesToElement"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment>The element object property relates Materials Libraries, Samples and compositions with the elements they are composed of.

The elements themselves are CheBI entities that can be individually accessed for more information (i.e., the formula for performing string matching)</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/givenName -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/givenName">
        <rdfs:comment>The given name of a person</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/hasAssignment -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/hasAssignment">
        <rdfs:domain rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/WorkflowModelInstance"/>
        <rdfs:range rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/WorkflowModelStepAssignment"/>
        <rdfs:comment>Indicates that the Handover workflow model instance has an assignment of samples to a Handover workflow model step further described in the target entity</rdfs:comment>
        <rdfs:label>Has assignment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/hasTemplate -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/hasTemplate">
        <rdfs:subPropertyOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/assignedTo"/>
        <rdfs:domain rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/WorkflowModelStep"/>
        <rdfs:range rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/WorkflowModelStepTemplate"/>
        <rdfs:comment>Indicates that the WorkflowModelStep has the target WorkflowModelStepTemplate</rdfs:comment>
        <rdfs:label>Has template</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/input -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/input">
        <owl:equivalentProperty rdf:resource="https://w3id.org/pmd/co/input"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment>The object property input is used to point at the anything that influenced or was used by a step in a handover workflow.

This is employed by the characterization activities (the leaf/most basic step of a handover workflow) to point at the actual results (e.g. a photo or EDX results file) they refer to.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/memberOfProject -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/memberOfProject">
        <rdfs:domain rdf:resource="https://w3id.org/pmd/co/Person"/>
        <rdfs:range rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/Project"/>
        <rdfs:label xml:lang="en">Member of project</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/name -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/name">
        <rdfs:comment>The name of a person</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/nextStep -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/nextStep">
        <owl:equivalentProperty rdf:resource="https://w3id.org/pmd/co/nextProcess"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasInformedBy"/>
        <rdfs:comment>The next step object property is used to indicate the next step in a chain of Handover Groups or Handovers.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/output -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/output">
        <owl:equivalentProperty rdf:resource="https://w3id.org/pmd/co/output"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment>The object property output is used to point at the results of a step in a handover workflow.

This is employed by the characterization activities (the leaf/most basic step of a handover workflow) to point at the actual results (e.g. a photo or EDX results file) they refer to.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/propertyToFollow -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/propertyToFollow">
        <rdfs:subPropertyOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/assignedTo"/>
        <rdfs:comment>Employed by a WorkflowModelStepAssignment entity to indicate the property that the validation process will use to query for the next target node(s) to assign to the next WorkflowModelStep to be validated, if any.</rdfs:comment>
        <rdfs:label>Property to follow</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/resource -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/resource">
        <owl:equivalentProperty rdf:resource="https://w3id.org/pmd/co/resource"/>
        <rdfs:domain rdf:resource="https://w3id.org/pmd/co/ValueObject"/>
        <rdfs:comment>The resource object property is used to indicate that an uploaded file in the RDMS is related in some way to a given Materials library / Sample

This property does not explicitly indicate that the given file is generated *for* the object it is connected to; instead, it indicates that they are *related* in a generic way.
To indicate the former, the connection should instead be the other way around via the crc:characteristic property, as is in the majority of cases.
             </rdfs:comment>
        <rdfs:label>Resource</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/substep -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/substep">
        <owl:equivalentProperty rdf:resource="https://w3id.org/pmd/co/subordinateProcess"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:comment>The substep object property is used to indicate a part of a step in a handover workflow that has been broken into smaller (sub)steps. This is also employed in handover workflow models.

More specifically, in a handover workflow, this is employed by Handover Groups to point to the start of the chain of handovers that they represent, and by an inidividual Handover to point to the individual characterization activities that happened inside it.</rdfs:comment>
        <rdfs:label>substep</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/surname -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/surname">
        <rdfs:comment>The surname of a person</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/workflowModelInstanceOf -->


    <owl:ObjectProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/workflowModelInstanceOf">
        <rdfs:domain rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/WorkflowModelInstance"/>
        <rdfs:range rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/WorkflowModel"/>
        <rdfs:comment>Indicates that the workflow model instance is specifying the target WorkflowModel</rdfs:comment>
        <rdfs:label>Workflow model instance of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/acceptedDate -->


    <owl:DatatypeProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/acceptedDate">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>The date a handover was accepted in the RDMS bt the destination user. Note that it does not need to match with its creation date</rdfs:comment>
        <rdfs:label>Accepted date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/allowsOtherActivities -->


    <owl:DatatypeProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/allowsOtherActivities">
        <rdfs:domain rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/WorkflowModelStep"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates that the handover group that the Handover workflow model step is validating is allowed to have activities other than the ones indicated by requiresActivity. If false, the presence of other activities will cause the validation to fail in this step.</rdfs:comment>
        <rdfs:label>Allows other activities</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/assignedShape -->


    <owl:DatatypeProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/assignedShape">
        <rdfs:domain rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/WorkflowModelStepTemplate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates that the WorkflowModelStepTemplate has the target SHACL shape string</rdfs:comment>
        <rdfs:label>Assigned shape</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/creationDate -->


    <owl:DatatypeProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/creationDate">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Activity"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Entity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">The creation date of an RDMS object</rdfs:comment>
        <rdfs:label xml:lang="en">Creation date</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/externalID -->


    <owl:DatatypeProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/externalID">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Activity"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Entity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/internalID -->


    <owl:DatatypeProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/internalID">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Activity"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Entity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/percentage -->


    <owl:DatatypeProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/percentage"/>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/resistance -->


    <owl:DatatypeProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/resistance">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/pmd/co/ChemicalComposition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment>Measured resistance in a specific measurement area of a sample</rdfs:comment>
        <rdfs:label>Resistance</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/templateKey -->


    <owl:DatatypeProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/templateKey">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/WorkflowModelStepTemplate"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The key used for a WorkflowModelStepTemplate</rdfs:comment>
        <rdfs:label>Template key</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/templateValue -->


    <owl:DatatypeProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/templateValue">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:comment>The value used for a WorkflowModelStepTemplate</rdfs:comment>
        <rdfs:label>Template value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/tolerance -->


    <owl:DatatypeProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/tolerance">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/pmd/co/ChemicalComposition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment>Measured tolerance in a specific measurement area of a sample</rdfs:comment>
        <rdfs:label>Tolerance</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/value -->


    <owl:DatatypeProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/value">
        <owl:equivalentProperty rdf:resource="https://w3id.org/pmd/co/value"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:comment>The raw value the entity referred by the characteristic object property refers to.

While the entity pointed by at by the crc:characteristic property may contain metadata such as creators and dates, its raw values (e.g. file paths or composition values) can be accessed by this property.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/x_position -->


    <owl:DatatypeProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/x_position">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/pmd/co/ChemicalComposition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment>X coordinate within a sample on which a composition was taken for a particular measurement area</rdfs:comment>
        <rdfs:label>X position</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/y_position -->


    <owl:DatatypeProperty rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/y_position">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/pmd/co/ChemicalComposition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment>X coordinate within a sample on which a composition was taken for a particular measurement area</rdfs:comment>
        <rdfs:label>Y position</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/AFMProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/AFMProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where AFM measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.
               Atomic Force Microscopy (AFM) is a surface characterization technique that maps the topography of a material by scanning a sharp probe across the surface and monitoring the tip–sample interaction forces.
               It provides nanometer- to atomic-scale height information and can also reveal surface roughness, grain structure, and local mechanical or adhesive contrasts, depending on the measurement mode.
               </rdfs:comment>
        <rdfs:label>AFM Process</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/APTProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/APTProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where APT measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.

               APT (Atom Probe Tomography) is a time-of-flight mass spectrometer that provides three-dimensional (3D) compositional information with sub-nanometer spatial resolution.
               APT specimens must be sharp and needle-shaped, with typical tip radii below 100 nm to facilitate the field evaporation of surface atoms in the form of ions, thereby enabling
               their analysis. APT is based on the principle of field evaporation, a process derived historically from field ion microscopy (FIM).</rdfs:comment>
        <rdfs:label>APT Process</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/AnnealingProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/AnnealingProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where annealing has been applied to the materials library or sample. Used by Activity instances and Activity Models to denote the type of measurements they refer to.

                     Annealing consists of a heat treatment applied to a materials library or sample, usually in the context of dealloying. </rdfs:comment>
        <rdfs:label>Annealing Process</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/BulkComposition -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/BulkComposition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/ChemicalObject"/>
        <rdfs:comment xml:lang="en">The composition of a Materials Library (i.e., the concentration of every atomic element present in it) as a whole</rdfs:comment>
        <rdfs:label xml:lang="en">Bulk Composition</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/Process"/>
        <rdfs:comment>A process that represents to the act of applying a measurement technique on an object in the CRC. Further specified by its subclasses.

Note: Not to be confused with prov:Activity, which acts as the superclass of Process.

An entity of this class or any of its subclasses indicates the nature of its measurements by also belonging to one of the *Process classes (e.g. FIMProcess)</rdfs:comment>
        <rdfs:label>Characterization activity</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivityInstance -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivityInstance">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/ProcessInstance"/>
        <rdfs:comment>A process that has as output a series of measurements of the same nature (e.g. EDX, TEM, FIM...) within the same handover of a sample in time, that results in one or more files being uploaded to the RDMS.

This is an additional abstraction that acts as a subordinate process of a handover, and has as outputs one or more measurements corresponding to the same type of measurement  (e.g., for EDX, EDX_raw and EDX_csv files).</rdfs:comment>
        <rdfs:label>Characterization activity instance</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/ChemicalObject -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/ChemicalObject">
        <owl:equivalentClass rdf:resource="https://w3id.org/pmd/co/ChemicalObject"/>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/ComputationalSample -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/ComputationalSample">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/DigitalEntity"/>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/EBSDProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/EBSDProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where EBSD measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.

               EBSD (Electron Backscatter Diffraction) is a method to measure the local orientations of a crystalline specimen from an electron backscatter diffraction pattern. Electrons are inelastically scattered on crystalline materials.
               The resulting pattern is characteristic of the crystal structure and lattice distances.
               An important feature of the EBSD method is crystal orientation mapping.
               </rdfs:comment>
        <rdfs:label>EBSD Process</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/EDXMicroscopyProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/EDXMicroscopyProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/MicroscopyProcess"/>
        <rdfs:comment>A process where EDX measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.

                         During EDX (Energy Dispersive X-Ray Spectroscopy), when the electrons hit the matter of the specimen, several interactions are possible. One is the production of characteristic x-ray, by kicking out an inner shell electron, whose space has to be filled by an outer shell electron.
                         The decrease in energy is emitted as X-ray quant. The energy of the x-rays is characteristic of the element; thus, this technique can be used to calculate the (bulk) composition of the sample.
                         Also called EDS (energy dispersive x-ray Spectroscopy)
                         </rdfs:comment>
        <rdfs:label>EDX Microscopy Process</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/EngineeredMaterial -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/EngineeredMaterial">
        <owl:equivalentClass rdf:resource="https://w3id.org/pmd/co/EngineeredMaterial"/>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/FIBProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/FIBProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where FIB measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.

               FIB (Focused Ion Beam) usually comes as a dual-beam system: SEM equipped with another beam source and optics, often Ga-ions or plasma.
               FIB enables milling and welding in a several nm to micrometer range and is used to prepare TEM or APT samples.
               </rdfs:comment>
        <rdfs:label>FIB Process</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/FIMProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/FIMProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where FIM measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.

               FIM (Field Ion Microscopy), is an imaging technique that visualizes the atomic structure of a sharply pointed specimen by ionizing gas atoms near its surface in a strong electric field.
               It provides direct real-space imaging of surface atoms and is often used to study atomic arrangements and tip structures at very high spatial resolution.</rdfs:comment>
        <rdfs:label>FIM Process</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/Handover -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/Handover">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/IdentifiableProcess"/>
        <rdfs:comment>The process of handing an object (for now, samples) from one person to another. This represents the transfer of physical objects between members of the same or different projects within the CRC to perform different analysis.</rdfs:comment>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/HandoverGroup -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/HandoverGroup">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/ProcessInstance"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:comment>Abstraction that has as subordinate process a chain or one or more handovers that took place consecutively within the same CRC project (i.e., all destination users belong to the sam eproject)</rdfs:comment>
        <rdfs:label>Handover group</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/HandoverWorkflow -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/HandoverWorkflow">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/Process"/>
        <rdfs:comment xml:lang="en">A process composed of a series of processing steps as part of the work of the CRC, which involve the act of physically moving a sample to be studied to another person and/or project.
Its subclasses narrow its application.</rdfs:comment>
        <rdfs:label>Handover workflow</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/HandoverWorkflowInstance -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/HandoverWorkflowInstance">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/HandoverWorkflow"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/ProcessInstance"/>
        <rdfs:comment xml:lang="en">The beginning of a series of processes belonging to the same sample in the RDMS.

An instance of this entity will contain a three-layer hierarchy of consecutive HandoverGroup instances, each containing a series of consecutive Handover instances, which finally can contain Activity Instance entities with measurements as their outputs.</rdfs:comment>
        <rdfs:label xml:lang="en">Handover workflow instance</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/IdeaOrExperimentPlan -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/IdeaOrExperimentPlan">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/IdentifiableProcess"/>
        <rdfs:comment xml:lang="en">An idea or experiment plan that may kickstart a Handover Workflow Model, requests for synthesis of samples and eventually a Handover Workflow Instance for one or more Materials Libraries</rdfs:comment>
        <rdfs:label xml:lang="en">Idea or experiment plan</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/IdentifiableProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/IdentifiableProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/ProcessInstance"/>
        <rdfs:comment>A process that is identified by an ID in the RDMS</rdfs:comment>
        <rdfs:label>Identifiable process</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/LiteratureReference -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/LiteratureReference">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/Document"/>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/MaterialsLibrary -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/MaterialsLibrary">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/EngineeredMaterial"/>
        <rdfs:comment xml:lang="en">A complete thin-film Materials Library, composed of 342 measurement areas to be analyzed or treated in any way.</rdfs:comment>
        <rdfs:label xml:lang="en">Materials Library</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/Measurement -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/Measurement">
        <owl:equivalentClass rdf:resource="https://w3id.org/pmd/co/Measurement"/>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/MeasurementArea -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/MeasurementArea">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/EngineeredMaterial"/>
        <rdfs:comment>One of the 342 defined locations of a materials library, which may be part of the materials library (thin film) itself, or a sample (piece) of it.</rdfs:comment>
        <rdfs:label>Measurement area</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/NoGradientSample -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/NoGradientSample">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/MaterialsLibrary"/>
        <rdfs:comment>From Satyakam</rdfs:comment>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/PhotoProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/PhotoProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where photos have been taken. Used by Activity instances and Activity Models to denote the type of measurements they refer to.</rdfs:comment>
        <rdfs:label>Photo Process</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/ProcessInstance -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/ProcessInstance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/Process"/>
        <rdfs:comment>A process that refers to a real event in the CRC / RDMS database, such a handover, or an abstraction over it (activities, virtual handovers and handover groups). Thus, it can be identifiable or not.</rdfs:comment>
        <rdfs:label xml:lang="en">Process Instance</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/ProcessModel -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/ProcessModel">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:comment xml:lang="en">A process that does not refer to a real event in the CRC / RDMS database.</rdfs:comment>
        <rdfs:label xml:lang="en">Process Model</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/Project -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/Project">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/Organization"/>
        <rdfs:comment>One of the projects of the CRC (e.g. A01, B03...)</rdfs:comment>
        <rdfs:label xml:lang="en">Project</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/Publication -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/Publication">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/Document"/>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/ReportProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/ReportProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where a non-synthesis related report has been uploaded (i.e., anything from presentations to .pdf documents). We treat it as a characterization. Used by Activity instances and Activity Models to denote the type of measurements they refer to.</rdfs:comment>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/RequestForSynthesis -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/RequestForSynthesis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/ValueObject"/>
        <rdfs:comment xml:lang="en">A request for the synthesis of a Materials Library / Sample with a desired composition.

Note that other parameters will be modelled in the future.</rdfs:comment>
        <rdfs:label xml:lang="en">Request for synthesis</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/ResistanceProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/ResistanceProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where Resistance measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.</rdfs:comment>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/SDCProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/SDCProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where SDC measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.

               SDC (Scanning Droplet Cell) is an electrochemical technique in which a small electrolyte droplet is brought into localized contact with a sample surface to perform spatially resolved measurements.
               It is used to map variations in electrochemical behavior across a material, for example, local activity.
               </rdfs:comment>
        <rdfs:label>SDC Process</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/SECCMProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/SECCMProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where SECCM measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.

                 SECCM (Scanning Electrochemical Cell Microscopy), is a localized electrochemical method in which a tiny liquid meniscus at the end of a nanopipette forms a confined electrochemical cell with the sample surface.
                 This allows spatially resolved mapping of surface electrochemical activity, making SECCM especially useful for linking local composition or structure to activity.</rdfs:comment>
        <rdfs:label>SECCM Process</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/SEMProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/SEMProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where SEM measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.

               In SEM (Scanning Electron Microscopy) an electron beam is rastered across the surface.
               The interaction with the sample (surface) produces several signals, which can be used for imaging, chemical analysis or analysis of the crystal structure.
               Secondary electrons and backscattered electrons can be used for image acquisition: the former gives a topography contrast, the latter a z-contrast (z = atomic number).
               Backscatter diffraction analysis (also see: EBSD) is a technique for crystal structure analysis. X-rays, produced during interaction with the sample, can give information about the chemical composition, usually analyzed using EDX, less commonly but more accurately: WDX.
               </rdfs:comment>
        <rdfs:label>SEM Process</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/STMProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/STMProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where STM measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.

               STM (Scanning tunneling microscopy) is a surface-imaging technique that uses a sharp conductive tip to measure tunneling current between the tip and a sample.
               It provides atomic-scale resolution and reveals the electronic and structural properties of conductive surfaces.
               </rdfs:comment>
        <rdfs:label>STM Process</rdfs:label>
    </owl:Class>
    


