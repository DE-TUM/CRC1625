        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where Resistance measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.</rdfs:comment>
    </owl:Class>
    


