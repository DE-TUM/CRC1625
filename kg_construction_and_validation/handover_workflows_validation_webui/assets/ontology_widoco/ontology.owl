        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where SECCM measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.</rdfs:comment>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/SEMProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/SEMProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where SEM measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.</rdfs:comment>
    </owl:Class>
    


