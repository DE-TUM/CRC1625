    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/Sample">
        <owl:equivalentClass rdf:resource="https://w3id.org/pmd/co/Sample"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/MaterialsLibrary"/>
        <rdfs:comment>A physical piece of a materials library, containing a subset of its 342 measurement areas.</rdfs:comment>
        <rdfs:label>Sample</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/StressChip -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/StressChip">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/MaterialsLibrary"/>
