     -->


    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/APTProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/APTProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where APT measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.</rdfs:comment>
        <rdfs:label>APT Process</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/AnnealingProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/AnnealingProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/BandgapProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/BandgapProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where Bandgap measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.</rdfs:comment>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/BulkComposition -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/BulkComposition">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/ChemicalObject"/>
        <rdfs:comment xml:lang="en">The composition of a Materials Library as a whole</rdfs:comment>
        <rdfs:label xml:lang="en">Bulk Composition</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/Process"/>
        <rdfs:comment>A process that represents to the act of applying a measurement technique on an object in the CRC. Further specified by its subclasses.

Note: Not to be confused with prov:Activity, which acts as the superclass of Process.

An entity of this class or any of its subclasses indicates the nature of its measurements by also belonging to one of the *Process classes (e.g. FIMProcess)</rdfs:comment>
        <rdfs:label>Characterization activity</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivityInstance -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivityInstance">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/ProcessInstance"/>
        <rdfs:comment>A process that has as output a series of measurements of the same nature (e.g. EDX, TEM, FIM...) within the same handover of a sample in time, that results in one or more files being uploaded to the RDMS.

This is an additional abstraction that acts as a subordinate process of a handover, and has as outputs one or more measurements corresponding to the same type of measurement  (e.g., for EDX, EDX_raw and EDX_csv files).</rdfs:comment>
        <rdfs:label>Characterization activity instance</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/ChemicalObject -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/ChemicalObject">
        <owl:equivalentClass rdf:resource="https://w3id.org/pmd/co/ChemicalObject"/>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/ComputationalSample -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/ComputationalSample">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/DigitalEntity"/>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/EDXMicroscopyProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/EDXMicroscopyProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/MicroscopyProcess"/>
        <rdfs:comment>A process where EDX measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.</rdfs:comment>
        <rdfs:label>EDX Microscopy Process</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/EngineeredMaterial -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/EngineeredMaterial">
        <owl:equivalentClass rdf:resource="https://w3id.org/pmd/co/EngineeredMaterial"/>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/FIMProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/FIMProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where FIM measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.</rdfs:comment>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/Handover -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/Handover">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/IdentifiableProcess"/>
        <rdfs:comment>The process of handing an object (for now, samples) from one person to another. This represents the transfer of physical objects between members of the same or different projects within the CRC to perform different analysis.</rdfs:comment>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/HandoverGroup -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/HandoverGroup">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/ProcessInstance"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:comment>Abstraction that has as subordinate process a chain or one or more handovers that took place consecutively within the same CRC project (i.e., all destination users belong to the sam eproject)</rdfs:comment>
        <rdfs:label>Handover group</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/HandoverWorkflow -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/HandoverWorkflow">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/Process"/>
        <rdfs:comment xml:lang="en">A process composed of a series of processing steps as part of the work of the CRC, which involve the act of physically moving a sample to be studied to another person and/or project.
Its subclasses narrow its application.</rdfs:comment>
        <rdfs:label>Handover workflow</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/HandoverWorkflowInstance -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/HandoverWorkflowInstance">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/HandoverWorkflow"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/ProcessInstance"/>
        <rdfs:comment xml:lang="en">The beginning of a series of processes belonging to the same sample in the RDMS.

An instance of this entity will contain a three-layer hierarchy of consecutive HandoverGroup instances, each containing a series of consecutive Handover instances, which finally can contain Activity Instance entities with measurements as their outputs.</rdfs:comment>
        <rdfs:label xml:lang="en">Handover workflow instance</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/IdeaOrExperimentPlan -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/IdeaOrExperimentPlan">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/IdentifiableProcess"/>
        <rdfs:comment xml:lang="en">An idea or experiment plan that may kickstart a Handover Workflow Model, requests for synthesis of samples and eventually a Handover Workflow Instance for one or more Materials Libraries</rdfs:comment>
        <rdfs:label xml:lang="en">Idea or experiment plan</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/IdentifiableProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/IdentifiableProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/ProcessInstance"/>
        <rdfs:comment>A process that is identified by an ID in the RDMS</rdfs:comment>
        <rdfs:label>Identifiable process</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/LEISProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/LEISProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where LEIS measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.</rdfs:comment>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/LiteratureReference -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/LiteratureReference">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/Document"/>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/MaterialsLibrary -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/MaterialsLibrary">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/EngineeredMaterial"/>
        <rdfs:comment xml:lang="en">A complete thin-film Materials Library, composed of 342 measurement areas to be analyzed or treated in any way.</rdfs:comment>
        <rdfs:label xml:lang="en">Materials Library</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/Measurement -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/Measurement">
        <owl:equivalentClass rdf:resource="https://w3id.org/pmd/co/Measurement"/>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/MeasurementArea -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/MeasurementArea">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/EngineeredMaterial"/>
        <rdfs:comment>One of the 342 defined locations of a materials library, which may be part of the materials library (thin film) itself, or a sample (piece) of it.</rdfs:comment>
        <rdfs:label>Measurement area</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/NoGradientSample -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/NoGradientSample">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/MaterialsLibrary"/>
        <rdfs:comment>From Satyakam</rdfs:comment>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/PSMProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/PSMProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/PhotoProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/PhotoProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where photos have been taken. Used by Activity instances and Activity Models to denote the type of measurements they refer to.</rdfs:comment>
        <rdfs:label>Photo Process</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/ProcessInstance -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/ProcessInstance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/Process"/>
        <rdfs:comment>A process that refers to a real event in the CRC / RDMS database, such a handover, or an abstraction over it (activities, virtual handovers and handover groups). Thus, it can be identifiable or not.</rdfs:comment>
        <rdfs:label xml:lang="en">Process Instance</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/ProcessModel -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/ProcessModel">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:comment xml:lang="en">A process that does not refer to a real event in the CRC / RDMS database.</rdfs:comment>
        <rdfs:label xml:lang="en">Process Model</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/Project -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/Project">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/Organization"/>
        <rdfs:comment>One of the projects of the CRC (e.g. A01, B03...)</rdfs:comment>
        <rdfs:label xml:lang="en">Project</rdfs:label>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/Publication -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/Publication">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/Document"/>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/ReportProcess -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/ReportProcess">
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/CharacterizationActivity"/>
        <rdfs:subClassOf rdf:resource="https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/AnalysingProcess"/>
        <rdfs:comment>A process where a non-synthesis related report has been uploaded (i.e., anything from presentations to .pdf documents). We treat it as a characterization. Used by Activity instances and Activity Models to denote the type of measurements they refer to.</rdfs:comment>
    </owl:Class>
    


    <!-- https://crc1625.mdi.ruhr-uni-bochum.de/RequestForSynthesis -->


    <owl:Class rdf:about="https://crc1625.mdi.ruhr-uni-bochum.de/RequestForSynthesis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/ValueObject"/>
        <rdfs:comment xml:lang="en">A request for the synthesis of a Materials Library / Sample with a desired composition.

Note that other parameters will be modelled in the future.</rdfs:comment>
        <rdfs:label xml:lang="en">Request for synthesis</rdfs:label>
    </owl:Class>
    


