SELECT DISTINCT
  ?MLOrSample
  ?MLOrSample_name

  ?handover_group
  ?handover_group_name

  ?handover_of_group
  ?handover_of_group_name

  ?activity
  ?activity_name

  ?output
  ?output_name

  ?nextGroup
  ?nextGroup_name

FROM <https://crc1625.mdi.ruhr-uni-bochum.de/graph>
WHERE {
  ?workflow_instance crc:input ?MLOrSample .
  ?MLOrSample crc:internalID "{internalID}"^^xsd:integer .
  ?workflow_instance crc:substep ?first_handover_group .

  ?first_handover_group crc:nextStep* ?handover_group .

  OPTIONAL {
    ?handover_group crc:nextStep ?nextGroup .
    OPTIONAL { ?nextGroup crc:objectName ?nextGroup_name . }
  }

  ?handover_group crc:substep ?handover_of_group .
  ?handover_of_group crc:substep ?activity .

  OPTIONAL {
    ?activity crc:output ?output .
    OPTIONAL { ?output crc:objectName ?output_name . }
  }

  OPTIONAL { ?MLOrSample crc:objectName ?MLOrSample_name . }
  OPTIONAL { ?handover_group crc:objectName ?handover_group_name . }
  OPTIONAL { ?handover_of_group crc:objectName ?handover_of_group_name . }
  OPTIONAL { ?activity crc:objectName ?activity_name . }
}