SELECT DISTINCT ?property ?property_label ?value ?value_name

FROM <https://crc1625.mdi.ruhr-uni-bochum.de/graph>

WHERE {
    ?entity ?property ?value .

    FILTER(STR(?entity) = {entityURI_LITERAL})

    # Retrieve the human-readable name of the property
    OPTIONAL {
        ?property rdfs:label ?property_label .
    }

    # Retrieve the human-readable name of the value
    OPTIONAL {
        ?value rdfs:label ?value_name .
    }
}

ORDER BY ?property ?value