SELECT ?user_name ?project_name
FROM <https://crc1625.mdi.ruhr-uni-bochum.de/graph>
WHERE {
  ?user a crc:User. # Class that all users belong to, we can exclude it as there are no other entities with crc:name, etc.

  # Name, given name and surname
  ?user crc:name ?user_name.
  ?user crc:internalID "{user_id}"^^xsd:integer.

  # The project they belong to (A06, B01...)
  ?user crc:memberOfProject ?project.
  ?project crc:objectName ?project_name.
}
