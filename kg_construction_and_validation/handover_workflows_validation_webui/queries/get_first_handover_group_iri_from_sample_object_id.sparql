SELECT ?handover_group_iri
FROM <https://crc1625.mdi.ruhr-uni-bochum.de/graph>
WHERE {
    GRAPH <https://crc1625.mdi.ruhr-uni-bochum.de/graph> {
        ?workflow_instance crc:substep ?handover_group_iri.
        ?workflow_instance crc:input ?ML_or_sample.
        ?ML_or_sample crc:internalID "{internal_id}"^^xsd:integer.
    }
}
