SELECT ?workflow_model ?workflow_model_name ?user_id WHERE {
    GRAPH <https://crc1625.mdi.ruhr-uni-bochum.de/graph/workflows> {
        ?workflow_model a crc:WorkflowModel.

        ?workflow_model rdfs:label ?workflow_model_name.

        ?workflow_model crc:creator ?user.
    }

    GRAPH <https://crc1625.mdi.ruhr-uni-bochum.de/graph> {
        ?user crc:internalID ?user_id.
    }
}