crc:ReportProcess rdf:type owl:Class ;
                  rdfs:subClassOf crc:CharacterizationActivity ,
                                  crc:UnidentifiableProcess ,
                                  pmdco:AnalysingProcess ;
                  rdfs:comment "A process where a non-synthesis related report has been uploaded (i.e., anything from presentations to .pdf documents). We treat it as a characterization. Used by Activity instances and Activity Models to denote the type of measurements they refer to." .


