crc:PSMProcess rdf:type owl:Class ;
               rdfs:subClassOf crc:CharacterizationActivity ,
                               crc:UnidentifiableProcess ,
                               pmdco:AnalysingProcess .


###  https://crc1625.mdi.ruhr-uni-bochum.de/PhotoProcess
crc:PhotoProcess rdf:type owl:Class ;
                 rdfs:subClassOf crc:CharacterizationActivity ,
                                 crc:UnidentifiableProcess ,
                                 pmdco:AnalysingProcess ;
                 rdfs:comment "A process where photos have been taken. Used by Activity instances and Activity Models to denote the type of measurements they refer to." ;
                 rdfs:label "Photo Process" .


###  https://crc1625.mdi.ruhr-uni-bochum.de/ProcessInstance
crc:ProcessInstance rdf:type owl:Class ;
                    rdfs:subClassOf pmdco:Process ;
                    rdfs:comment "A process that refers to a real event in the CRC / RDMS database, such a handover, or an abstraction over it (activities, virtual handovers and handover groups). Thus, it can be identifiable or not." ;
                    rdfs:label "Process Instance"@en .


###  https://crc1625.mdi.ruhr-uni-bochum.de/ProcessModel
crc:ProcessModel rdf:type owl:Class ;
                 rdfs:subClassOf crc:UnidentifiableProcess ;
                 rdfs:comment "A process that does not refer to a real event in the CRC / RDMS database."@en ;
                 rdfs:label "Process Model"@en .


