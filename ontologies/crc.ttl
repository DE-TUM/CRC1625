                    rdfs:label "Synthesis or treatment Report"@en .


###  https://crc1625.mdi.ruhr-uni-bochum.de/SynthesisOrTreatmentProcess
crc:SynthesisOrTreatmentProcess rdf:type owl:Class ;
               rdfs:subClassOf crc:CharacterizationActivity ,
                               crc:UnidentifiableProcess ,
                               pmdco:AnalysingProcess ;
               rdfs:comment "A process where a synthesis or treatment has been performed, resulting in a synthesis report. We treat it as a characterization. Used by Activity instances and Activity Models to denote the type of measurements they refer to." .



###  https://crc1625.mdi.ruhr-uni-bochum.de/TEMProcess
crc:TEMProcess rdf:type owl:Class ;
               rdfs:subClassOf crc:CharacterizationActivity ,
                               crc:UnidentifiableProcess ,
                               pmdco:AnalysingProcess ;
               rdfs:comment """A process where TEM measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to.

               In (S)TEM, standing for (Scanning) Transmission Electron Microscopy, the electron beam of the TEM is focused on a small spot and rastered across the specimen as in SEM.
               The spot size controls the resolution of the resulting image. Depending on the detector, different types of dark field (DF) or bright field (BF) images can be recorded.
               """ ;
               rdfs:label "TEM Process" .


###  https://crc1625.mdi.ruhr-uni-bochum.de/ThicknessProcess
crc:ThicknessProcess rdf:type owl:Class ;
                     rdfs:subClassOf crc:CharacterizationActivity ,
                                     crc:UnidentifiableProcess ,
                                     pmdco:AnalysingProcess ;
                     rdfs:comment "A process where Thickness measurements have been performed. Used by Activity instances and Activity Models to denote the type of measurements they refer to." ;
                     rdfs:label: "Thickness Process" .

###  https://crc1625.mdi.ruhr-uni-bochum.de/UnidentifiableProcess
crc:UnidentifiableProcess rdf:type owl:Class ;
                          rdfs:subClassOf pmdco:Process ;
                          rdfs:comment "A process that is not identified by an ID in the RDMS" ;
                          rdfs:label "Unidentifiable process" .


