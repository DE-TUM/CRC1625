crc:MeasurementArea rdf:type owl:Class ;
                    rdfs:subClassOf pmdco:EngineeredMaterial ;
                    rdfs:comment "One of the 342 defined locations of a materials library, which may be part of the materials library (thin film) itself, or a sample (piece) of it." ;
                    rdfs:label "Measurement area" .


###  https://crc1625.mdi.ruhr-uni-bochum.de/NoGradientSample
crc:NoGradientSample rdf:type owl:Class ;
