crc:MeasurementArea rdf:type owl:Class ;
                    rdfs:subClassOf pmdco:EngineeredMaterial ;
                    rdfs:comment "One of the 342 defined locations of a materials library, which may be part of the materials library (thin film) itself, or a sample (piece) of it." ;
                    rdfs:label "Measurement area" .


###  https://crc1625.mdi.ruhr-uni-bochum.de/NoGradientSample
crc:NoGradientSample rdf:type owl:Class ;
                     rdfs:subClassOf crc:MaterialsLibrary ;
                     rdfs:comment "From Satyakam" .


###  https://crc1625.mdi.ruhr-uni-bochum.de/PhotoProcess
crc:PhotoProcess rdf:type owl:Class ;
                 rdfs:subClassOf crc:CharacterizationActivity ,
                                 crc:UnidentifiableProcess ,
                                 pmdco:AnalysingProcess ;
                 rdfs:comment "A process where photos have been taken. Used by Activity instances and Activity Models to denote the type of measurements they refer to." ;
                 rdfs:label "Photo Process" .


###  https://crc1625.mdi.ruhr-uni-bochum.de/ProcessInstance
crc:ProcessInstance rdf:type owl:Class ;
                    rdfs:subClassOf pmdco:Process ;
                    rdfs:comment "A process that refers to a real event in the CRC / RDMS database, such a handover, or an abstraction over it (activities, virtual handovers and handover groups). Thus, it can be identifiable or not." ;
                    rdfs:label "Process Instance"@en .


###  https://crc1625.mdi.ruhr-uni-bochum.de/ProcessModel
crc:ProcessModel rdf:type owl:Class ;
                 rdfs:subClassOf crc:UnidentifiableProcess ;
                 rdfs:comment "A process that does not refer to a real event in the CRC / RDMS database, and instead refers to an entity within a Handover Workflow Model, such as a Handover workflow model step, an activity required by it or a Handover workflow step assignment."@en ;
                 rdfs:label "Process Model"@en .


###  https://crc1625.mdi.ruhr-uni-bochum.de/Project
crc:Project rdf:type owl:Class ;
            rdfs:subClassOf pmdco:Organization ;
            rdfs:comment "One of the projects of the CRC (e.g. A01, B03...)" ;
            rdfs:label "Project"@en .


