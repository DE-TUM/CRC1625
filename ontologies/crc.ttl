crc:RequestForSynthesis rdf:type owl:Class ;
                        rdfs:subClassOf pmdco:ValueObject ;
                        rdfs:comment """A request for the synthesis of a Materials Library / Sample with a desired composition.

Note that other parameters will be modelled in the future."""@en ;
                        rdfs:label "Request for synthesis"@en .


